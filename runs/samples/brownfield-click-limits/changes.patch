@@ -22,5 +22,32 @@
 
 
 def init_db(engine: Engine) -> None:
-    """Create tables. Schema changes after v1 go through migrations, not this call."""
+    """Create missing tables, then apply additive column migrations to existing ones."""
     Base.metadata.create_all(engine)
+    add_missing_columns(engine)
+
+
+def add_missing_columns(engine: Engine) -> list[str]:
+    """Additive-only migration: add nullable columns that exist in the models but not the DB.
+
+    Databases created by earlier versions keep working without a manual step. Only nullable
+    columns are added (safe, no backfill); anything else must go through a reviewed migration.
+    """
+    added: list[str] = []
+    inspector = inspect(engine)
+    for table in Base.metadata.sorted_tables:
+        if not inspector.has_table(table.name):
+            continue
+        existing = {c["name"] for c in inspector.get_columns(table.name)}
+        for column in table.columns:
+            if column.name in existing:
+                continue
+            if not column.nullable:
+                raise RuntimeError(
+                    f"column {table.name}.{column.name} is NOT NULL; needs a manual migration"
+                )
+            ddl = column.type.compile(dialect=engine.dialect)
+            with engine.begin() as conn:
+                conn.execute(text(f'ALTER TABLE "{table.name}" ADD COLUMN "{column.name}" {ddl}'))
+            added.append(f"{table.name}.{column.name}")
+    return added
