+def is_blocked_host(host: str, blocked: frozenset[str]) -> bool:
+    """True if ``host`` is a blocked domain or a subdomain of one."""
+    host = host.lower().rstrip(".")
+    return any(host == d or host.endswith("." + d) for d in blocked)
+
+
+def destination_is_blocked(url: str, blocked: frozenset[str]) -> bool:
+    return bool(blocked) and is_blocked_host(urlsplit(url).hostname or "", blocked)
+
+
