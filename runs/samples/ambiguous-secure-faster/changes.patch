diff --git a/tests/integration/test_denylist_create.py b/tests/integration/test_denylist_create.py
new file mode 100644
--- /dev/null
+++ b/tests/integration/test_denylist_create.py
@@ -0,0 +1,24 @@
+import pytest
+from fastapi.testclient import TestClient
+
+from service.config import Settings
+from service.main import create_app
+
+
+@pytest.fixture
+def guarded():
+    app = create_app(Settings(database_url="sqlite://", blocked_domains="phish.example"))
+    yield TestClient(app, follow_redirects=False)
+    app.state.engine.dispose()
+
+
+@pytest.mark.parametrize("url", ["https://phish.example/login", "http://secure.phish.example/"])
+def test_blocked_destinations_cannot_be_shortened(guarded, url):
+    r = guarded.post("/api/v1/urls", json={"url": url})
+    assert r.status_code == 422
+    assert r.json()["detail"] == "destination domain is blocked"
+
+
+def test_other_destinations_still_work(guarded):
+    r = guarded.post("/api/v1/urls", json={"url": "https://phish.example.org/ok"})
+    assert r.status_code == 201
diff --git a/tests/integration/test_denylist_redirect.py b/tests/integration/test_denylist_redirect.py
new file mode 100644
--- /dev/null
+++ b/tests/integration/test_denylist_redirect.py
@@ -0,0 +1,29 @@
+from fastapi.testclient import TestClient
+
+from service.config import Settings
+from service.main import create_app
+
+
+def test_existing_links_stop_redirecting_once_domain_is_blocked(tmp_path):
+    db = f"sqlite:///{tmp_path / 'links.db'}"
+    before = create_app(Settings(database_url=db))
+    c1 = TestClient(before, follow_redirects=False)
+    code = c1.post("/api/v1/urls", json={"url": "https://login.phish.example/a"}).json()["code"]
+    safe = c1.post("/api/v1/urls", json={"url": "https://good.example/a"}).json()["code"]
+    assert c1.get(f"/{code}").status_code == 302
+    before.state.engine.dispose()
+
+    after = create_app(Settings(database_url=db, blocked_domains="phish.example"))
+    c2 = TestClient(after, follow_redirects=False)
+    r = c2.get(f"/{code}")
+    assert r.status_code == 410
+    assert r.json()["detail"] == "destination has been blocked"
+    assert c2.get(f"/{safe}").status_code == 302
+    after.state.engine.dispose()
+
+
+def test_block_applies_to_cached_links(app, client):
+    code = client.post("/api/v1/urls", json={"url": "https://bad.test/x"}).json()["code"]
+    assert client.get(f"/{code}").status_code == 302  # now cached
+    app.state.settings.blocked_domains = "bad.test"
+    assert client.get(f"/{code}").status_code == 410
diff --git a/tests/unit/test_denylist.py b/tests/unit/test_denylist.py
new file mode 100644
--- /dev/null
+++ b/tests/unit/test_denylist.py
@@ -0,0 +1,23 @@
+from service.config import Settings, parse_domains
+from service.core.validation import destination_is_blocked, is_blocked_host
+
+BLOCKED = frozenset({"phish.example", "bad.test"})
+
+
+def test_parse_domains_normalises():
+    assert parse_domains(" Phish.Example. , ,bad.test") == BLOCKED
+    assert parse_domains("") == frozenset()
+    assert Settings(blocked_domains="a.com,b.com").blocked_domain_set == {"a.com", "b.com"}
+
+
+def test_blocked_host_matches_domain_and_subdomains_only():
+    assert is_blocked_host("phish.example", BLOCKED)
+    assert is_blocked_host("login.PHISH.example.", BLOCKED)
+    assert not is_blocked_host("notphish.example", BLOCKED)
+    assert not is_blocked_host("phish.example.com", BLOCKED)
+
+
+def test_destination_is_blocked():
+    assert destination_is_blocked("https://www.bad.test/x", BLOCKED)
+    assert not destination_is_blocked("https://good.example/x", BLOCKED)
+    assert not destination_is_blocked("https://bad.test/x", frozenset())
