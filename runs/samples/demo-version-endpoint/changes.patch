diff --git a/tests/integration/test_version.py b/tests/integration/test_version.py
new file mode 100644
--- /dev/null
+++ b/tests/integration/test_version.py
@@ -0,0 +1,8 @@
+def test_version_endpoint_returns_app_version(client, app):
+    r = client.get("/api/v1/version")
+    assert r.status_code == 200
+    assert r.json() == {"version": app.version}
+
+
+def test_version_path_is_not_treated_as_short_code(client):
+    assert client.get("/api/v1/version").headers["content-type"].startswith("application/json")
