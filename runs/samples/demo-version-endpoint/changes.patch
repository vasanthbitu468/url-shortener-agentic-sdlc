+++ b/docs/changes/version-endpoint.md
@@ -0,0 +1,13 @@
+# Version endpoint
+
+`GET /api/v1/version` returns the version of the running service.
+
+```bash
+curl http://localhost:8000/api/v1/version
+# {"version": "1.0.0"}
+```
+
+## Decision (ADR-001)
+
+The version is read from the FastAPI application object, so a release only bumps it in one place.
+No authentication is required: the version is not sensitive.
diff --git a/service/api/version.py b/service/api/version.py
new file mode 100644
--- /dev/null
+++ b/service/api/version.py
@@ -0,0 +1,16 @@
+"""Service metadata endpoints."""
+
+from fastapi import APIRouter, Request
+from pydantic import BaseModel
+
+router = APIRouter(prefix="/api/v1", tags=["meta"])
+
+
+class VersionResponse(BaseModel):
+    version: str
+
+
+@router.get("/version", response_model=VersionResponse)
+def version(request: Request) -> VersionResponse:
+    """Return the version of the running service."""
+    return VersionResponse(version=request.app.version)
